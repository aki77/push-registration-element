{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2022",
		"lib": ["es2022", "dom", "DOM.Iterable"],
		"strict": true,
		"declaration": true,
		"rootDir": "./src",
		"outDir": "dist",
		"removeComments": true,
		"preserveConstEnums": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*.ts"]
}
